{%- comment -%} Dearly 14. The guarantee. Carries the weight reviews normally would, so it gets room. {%- endcomment -%}
<div class="d-section d-raised d-guarantee">
  <div class="d-wrap d-pad">
    <div class="d-measure">
      <svg class="d-seal" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
        <circle cx="22" cy="22" r="20.5" fill="none" stroke="currentColor" stroke-width="1"/>
        <circle cx="22" cy="22" r="16" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 2.2"/>
        <path d="M22 30.5c-4.6-3.4-7.5-6-7.5-9.1 0-2.2 1.7-3.9 3.8-3.9 1.5 0 2.8.8 3.7 2.1.9-1.3 2.2-2.1 3.7-2.1 2.1 0 3.8 1.7 3.8 3.9 0 3.1-2.9 5.7-7.5 9.1z" fill="none" stroke="currentColor" stroke-width="1"/>
      </svg>
      <h2 class="d-h2">{{ section.settings.headline | escape }}</h2>
      <div class="d-voice d-lead d-pretty">{{ section.settings.body }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dearly 14: Guarantee",
  "tag": "section",
  "class": "dearly-band",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "90 days to change your mind" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>If she doesn’t love it, email us within 90 days and we refund you in full. No photos, no return form, no questions about why.</p><p>You’re buying a feeling, and if it doesn’t land, you shouldn’t have to pay for it.</p>" }
  ],
  "presets": [{ "name": "Dearly 14: Guarantee" }]
}
{% endschema %}
