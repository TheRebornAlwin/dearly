{%- comment -%}
  Dearly 17. FAQ. Accordion with real buttons and aria-expanded; the first answer starts open.
  FAQPage JSON-LD is built from the same blocks, so the markup and the data never drift apart.
{%- endcomment -%}
<div class="d-section" id="faq">
  <div class="d-wrap d-pad">
    <div class="d-measure" data-d-faq>
      <h2 class="d-h2">{{ section.settings.headline | escape }}</h2>
      <div class="d-faq__list">
        {%- for block in section.blocks -%}
          {%- assign qid = 'd-faq-' | append: section.id | append: '-' | append: forloop.index -%}
          <div class="d-faq__item" {{ block.shopify_attributes }}>
            <h3 class="d-faq__q">
              <button type="button" class="d-faq__btn" id="{{ qid }}-q" aria-controls="{{ qid }}-a" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                <span>{{ block.settings.question | escape }}</span>
                <svg class="d-faq__icon" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                  <rect x="0" y="6.5" width="14" height="1"/>
                  <rect class="d-faq__v" x="6.5" y="0" width="1" height="14"/>
                </svg>
              </button>
            </h3>
            <div class="d-faq__a d-pretty" id="{{ qid }}-a" role="region" aria-labelledby="{{ qid }}-q" {% unless forloop.first %}hidden="until-found"{% endunless %}>
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Dearly 17: FAQ",
  "tag": "section",
  "class": "dearly-band",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "headline", "label": "Heading", "default": "Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dearly 17: FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Will it tarnish or turn her skin green?", "answer": "<p>No. The pendant is plated over stainless steel, not brass or copper, so it won’t oxidize or leave a mark. It’s safe in the shower and safe to sleep in. Take it off for a pool or the ocean, since chlorine and salt dull any plating over time.</p>" } },
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>7 to 14 business days to most countries, free. You’ll get a tracking link by email as soon as it ships. If you need it for a specific date, order with at least three weeks of room.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship outside the US?", "answer": "<p>Yes, worldwide, and shipping is free everywhere. Orders outside the US and Canada tend toward the longer end of the 7 to 14 day window.</p>" } },
        { "type": "question", "settings": { "question": "Will there be a price or a receipt in the box?", "answer": "<p>No. Nothing in the package shows what you paid. No invoice, no price tag, no packing slip with a total. Your receipt goes to your email only.</p>" } },
        { "type": "question", "settings": { "question": "What if the chain is the wrong length?", "answer": "<p>It adjusts from 18 to 22 inches, which covers collarbone to just below it on almost everyone. If it still isn’t right, the 90-day return covers it.</p>" } },
        { "type": "question", "settings": { "question": "What if it arrives damaged?", "answer": "<p>Email us a photo and we send a replacement at no cost. You don’t need to send the damaged one back.</p>" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>90 days, full refund, no questions asked. Email <a href=\"mailto:hello@givedearly.com\">hello@givedearly.com</a> and we handle it.</p>" } },
        { "type": "question", "settings": { "question": "Why buy this instead of something on Amazon?", "answer": "<p>You can find a heart pendant for less. What’s harder to find is one that shows up ready to give, with the card already written and inside the box, and no price anywhere in the package. That’s what you’re paying for. If it isn’t worth it to you, buy the cheaper one. We won’t be offended.</p>" } }
      ]
    }
  ]
}
{% endschema %}
